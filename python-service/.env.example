# FastAPI application name
PROJECT_NAME=AI Interactive Lecture API

# Vector database (only needed when enabling Milvus-based retrieval)
MILVUS_URI=http://localhost:19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_DB_NAME=default
COLLECTION_NAME=lecture_knowledge

# Embedding model configuration
EMBEDDING_PROVIDER=dashscope
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL_NAME=text-embedding-v4
EMBEDDING_DIM_SIZE=1024
DASHSCOPE_API_KEY=

# Chaoxing real-course import test input.
# Keep real Cookie only in local .env. Do not commit it.
CHAOXING_COURSE_URL=
CHAOXING_COURSE_ID=
CHAOXING_CLAZZ_ID=
CHAOXING_CPI=
CHAOXING_ENC=
CHAOXING_T=
CHAOXING_COOKIE=
CHAOXING_AUTHORIZATION=
CHAOXING_USER_AGENT=

# Course resource importer CLI aliases.
# Copy the same Chaoxing auth values here when using python -m app.course_resource_importer.cli.
RESOURCE_COOKIE=
RESOURCE_AUTHORIZATION=
RESOURCE_REFERER=
RESOURCE_USER_AGENT=
RESOURCE_OUTPUT_DIR=./data/chaoxing-real-test

# Optional Qwen VL / Bailian vision model configuration
# Keep disabled by default so local fallback demos do not require a paid API key.
VISION_ENABLED=false
VISION_PROVIDER=qwen-vl
VISION_API_KEY=
VISION_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL_NAME=qwen3-vl-plus
VISION_TEMPERATURE=0.2
VISION_MAX_TOKENS=512
VISION_TIMEOUT=120
VISION_MAX_IMAGE_BYTES=7340032
VISION_TRUST_ENV_PROXY=false

# LLM configuration
# You can use either the generic LLM_* variables or the DeepSeek-specific aliases.
# Local minimal integration can leave the key empty and fallback logic will be used.
LLM_API_KEY=
LLM_API_BASE=https://api.deepseek.com
LLM_MODEL_NAME=deepseek-v4-pro
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120
LLM_REASONING_EFFORT=high
LLM_ENABLE_THINKING=true

# Optional DeepSeek aliases (kept empty by default)
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL_NAME=deepseek-v4-pro
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_ENABLE_THINKING=true
