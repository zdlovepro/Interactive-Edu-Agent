# FastAPI application name
PROJECT_NAME=AI Interactive Lecture API

# Vector database (only needed when enabling Milvus-based retrieval)
MILVUS_URI=http://localhost:19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_DB_NAME=default
COLLECTION_NAME=lecture_knowledge

# Embedding model configuration
EMBEDDING_PROVIDER=dashscope
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL_NAME=text-embedding-v4
EMBEDDING_DIM_SIZE=1024
DASHSCOPE_API_KEY=

# LLM configuration
# You can use either the generic LLM_* variables or the DeepSeek-specific aliases.
# Local minimal integration can leave the key empty and fallback logic will be used.
LLM_API_KEY=
LLM_API_BASE=https://api.deepseek.com
LLM_MODEL_NAME=deepseek-v4-pro
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120
LLM_REASONING_EFFORT=
LLM_ENABLE_THINKING=false
STRICT_CHAIN=false
RENDER_BASE_DIR=./data/render
DIGITAL_HUMAN_ENABLED=false
DIGITAL_HUMAN_API_KEY=
DIGITAL_HUMAN_MODEL_NAME=videoretalk
DIGITAL_HUMAN_REF_VIDEO_PATH=/workspace/assets/digital-human/reference/avatar.mp4
DIGITAL_HUMAN_REF_IMAGE_PATH=/workspace/assets/digital-human/reference/OIP.png
DIGITAL_HUMAN_MAX_SEGMENTS=1
DIGITAL_HUMAN_MAX_SEGMENT_RATIO=0.25
DIGITAL_HUMAN_MIN_PAGE_GAP=2
DIGITAL_HUMAN_MIN_IMPORTANCE_SCORE=0.55
DIGITAL_HUMAN_MIN_AUDIO_SECONDS=2
DIGITAL_HUMAN_MAX_AUDIO_SECONDS=10
DIGITAL_HUMAN_LEAD_TRIM_SECONDS=0
DIGITAL_HUMAN_OVERLAY_WIDTH_RATIO=0.22
DIGITAL_HUMAN_OVERLAY_MARGIN_TOP=0
DIGITAL_HUMAN_OVERLAY_MARGIN_RIGHT=0
DIGITAL_HUMAN_POLL_INTERVAL_SECONDS=5
DIGITAL_HUMAN_TASK_TIMEOUT_SECONDS=1800
DIGITAL_HUMAN_VIDEO_EXTENSION=true

# Optional DeepSeek aliases (kept empty by default)
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL_NAME=deepseek-v4-pro
DEEPSEEK_REASONING_EFFORT=
DEEPSEEK_ENABLE_THINKING=false

# Redis / Chaoxing QR auth
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=
CHAOXING_AUTH_HEADLESS=true
CHAOXING_AUTH_TTL_SECONDS=7200
CHAOXING_AUTH_TIMEOUT_SECONDS=180

# MinIO object storage for full mode parse
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=courseware
MINIO_SECURE=false
