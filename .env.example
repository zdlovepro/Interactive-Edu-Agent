# Backend runtime profile.
# The backend defaults to `local` when this is omitted.
SPRING_PROFILES_ACTIVE=local

# Shared backend settings.
PYTHON_CLIENT_BASE_URL=http://localhost:8001
PYTHON_CLIENT_CONNECT_TIMEOUT=5s
PYTHON_CLIENT_READ_TIMEOUT=30s
PYTHON_VIDEO_RENDER_READ_TIMEOUT=60m
PYTHON_COURSE_RESOURCE_IMPORT_PATH=/python/v1/course-resource-import/import
PYTHON_CHAOXING_AUTH_PATH=/python/v1/chaoxing/auth/sessions
STRICT_CHAIN=false
RENDER_BASE_DIR=./data/render
DIGITAL_HUMAN_ENABLED=false
DIGITAL_HUMAN_API_KEY=
DIGITAL_HUMAN_MODEL_NAME=wan2.7-r2v
DIGITAL_HUMAN_REF_IMAGE_PATH=
DIGITAL_HUMAN_MAX_SEGMENTS=1
DIGITAL_HUMAN_MAX_SEGMENT_RATIO=0.25
DIGITAL_HUMAN_MIN_PAGE_GAP=2
DIGITAL_HUMAN_MIN_IMPORTANCE_SCORE=0.55
DIGITAL_HUMAN_MIN_AUDIO_SECONDS=2
DIGITAL_HUMAN_MAX_AUDIO_SECONDS=10
DIGITAL_HUMAN_LEAD_TRIM_SECONDS=1.5
DIGITAL_HUMAN_OVERLAY_WIDTH_RATIO=0.22
DIGITAL_HUMAN_OVERLAY_MARGIN_TOP=0
DIGITAL_HUMAN_OVERLAY_MARGIN_RIGHT=0
DIGITAL_HUMAN_POLL_INTERVAL_SECONDS=5
DIGITAL_HUMAN_TASK_TIMEOUT_SECONDS=1800
DIGITAL_HUMAN_VIDEO_EXTENSION=true
TTS_ENABLED=false
ASR_ENABLED=true
ASR_PROVIDER=qwen

# Python LLM configuration. Leave the key empty for local fallback mode.
LLM_API_KEY=
LLM_API_BASE=https://api.deepseek.com
LLM_MODEL_NAME=deepseek-v4-pro
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120
LLM_REASONING_EFFORT=
LLM_ENABLE_THINKING=false

# Full mode only: MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=interactive_edu
MYSQL_USERNAME=root
MYSQL_PASSWORD=change-me-mysql-password

# Full mode only: Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=

# Full mode only: MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=change-me-minio-access-key
MINIO_SECRET_KEY=change-me-minio-secret-key
MINIO_BUCKET=courseware
MINIO_SECURE=false

# Optional: DashScope TTS, only needed when TTS_ENABLED=true
DASHSCOPE_API_KEY=
ASR_QWEN_API_KEY=
QWEN_ASR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_ASR_MODEL=qwen3-asr-flash
QWEN_ASR_ENABLE_ITN=true
QWEN_ASR_LANGUAGE=
QWEN_ASR_MAX_FILE_SIZE_MB=10
QWEN_ASR_TIMEOUT_SECONDS=60
TTS_DASHSCOPE_MODEL=cosyvoice-v3-flash
TTS_DASHSCOPE_VOICE=longanyang
TTS_DASHSCOPE_WEBSOCKET_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
TTS_DASHSCOPE_FORMAT=mp3
TTS_DASHSCOPE_SAMPLE_RATE=24000
TTS_DASHSCOPE_SPEECH_RATE=0
TTS_DASHSCOPE_PITCH_RATE=0
TTS_DASHSCOPE_VOLUME=50

# Python / Chaoxing auth helper
REDIS_URL=
CHAOXING_AUTH_HEADLESS=true
CHAOXING_AUTH_TTL_SECONDS=7200
